ZENROWS_API_KEY=your_api_key_here

# Optional: enable browser tools
# ZENROWS_BROWSER_URL=http://localhost:12345

# Optional: credential introspection endpoint used to enforce per-tool scopes for
# scoped agent credentials. Legacy user API keys are unaffected (no scope data).
# ZENROWS_INTROSPECTION_URL=https://api.zenrows.com/me/credential
